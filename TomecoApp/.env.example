APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Laravel uses this 256-bit key with AES-256-CBC. Never commit or share the real key.
# Generate it once per environment with: php artisan key:generate
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Restrict this browser-visible key to authorized TOMECO domains and Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY= AIzaSyB9KETjJ8rZnkz5SEWaX35NNhVb4eU1woo

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=tomeco
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

OFFICER_LOCATION_ACTIVE_SECONDS=30
OFFICER_LOCATION_OFFLINE_SECONDS=120
OFFICER_LOCATION_HISTORY_INTERVAL_SECONDS=45
OFFICER_LOCATION_HISTORY_DISTANCE_METERS=25
OFFICER_LOCATION_LOW_ACCURACY_METERS=50
